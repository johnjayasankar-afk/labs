{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/ridelens",
      "destination": "https://ride-lens2.vercel.app/",
      "permanent": false
    },
    {
      "source": "/daylight",
      "destination": "https://daylight-app-wine.vercel.app/",
      "permanent": false
    },
    {
      "source": "/raildrop",
      "destination": "https://rail-drop3.vercel.app/",
      "permanent": false
    },
    {
      "source": "/gridiron",
      "destination": "https://gridiron-pink-chi.vercel.app/",
      "permanent": false
    },
    {
      "source": "/agentfit",
      "destination": "https://agent-fit2.vercel.app/",
      "permanent": false
    },
    {
      "source": "/cartonry",
      "destination": "https://cartonry.vercel.app/",
      "permanent": false
    },
    {
      "source": "/keepfloor",
      "destination": "https://keep-floor.vercel.app/",
      "permanent": false
    },
    {
      "source": "/pricing",
      "destination": "https://pricing-hub-seven.vercel.app/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(css|js|img)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ]
}
