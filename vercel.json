{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ],
  "redirects": [
    { "source": "/ridelens", "destination": "https://ride-lens2.vercel.app/", "permanent": false },
    { "source": "/raildrop", "destination": "https://rail-drop3.vercel.app/", "permanent": false },
    { "source": "/daylight", "destination": "https://daylight-app-wine.vercel.app/", "permanent": false },
    { "source": "/agentfit", "destination": "https://agent-fit2.vercel.app/", "permanent": false },
    { "source": "/cartonry", "destination": "https://cartonry.vercel.app/", "permanent": false },
    { "source": "/keepfloor", "destination": "https://keep-floor.vercel.app/", "permanent": false },
    { "source": "/pricing", "destination": "https://pricing-hub-seven.vercel.app/", "permanent": false }
  ]
}
